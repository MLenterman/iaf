<!--
Download ibisdoc.xsd from the Ibis console (via /rest/webservices). You can
refer to it directly in the xsi:noNamespaceSchemaLocation attribute but it is
better to refer to it using Eclipse, Window, Preferences, XML, XML Catalog,
Add..., Location: path/to/ibisdoc.xsd, Key:
http://schemas.ibissource.org/ibisdoc.xsd, OK
-->
<Module
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="http://schemas.ibissource.org/ibisdoc.xsd"
	name="My first beautiful configuration"
	>
	<Adapter name="HandlebarsExampleOpenApi" active="${HandlebarsExampleOpenApi.active}">
		<Receiver
			name="HandlebarsExampleOpenApi"
			>
			<ApiListener
				name="HandlebarsExampleOpenApi"
				uriPattern="/handlebars/example1"
			/>
		</Receiver>
		<Pipeline>
			<Exits>
				<Exit name="EXIT" state="SUCCESS"/>
				<Exit name="ERROR" state="ERROR"/>
			</Exits>
			
			<FixedResultPipe 
				name="ReadFile" 
				filename="zaken/openapi-zaken.json"
				storeResultInSessionKey="openapifile"
				>
				<Forward name="EXIT" path="HandlebarsPipe" />
			</FixedResultPipe>

			
            
            <pipe
				name="HandlebarsPipe"
				className="nl.nn.adapterframework.pipes.HandlebarsPipe"
				templateName="pipe"
				openApiFilename="zaken/openapi.yaml"
				>
				<forward name="success" path="EXIT"/>
			</pipe>
			
		</Pipeline>
	</Adapter>
</Module>
